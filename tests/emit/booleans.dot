digraph AST {
    graph [rankdir=TB, bgcolor="transparent", nodesep=0.3, ranksep=0.5];
    node [shape=box, style="rounded,filled", penwidth=1.4, fontname="Menlo,Consolas,monospace", fontsize=11, fontcolor="#0f172a", margin="0.14,0.08"];
    edge [color="#94a3b8", penwidth=1.2, arrowsize=0.6];

    n0 [label="Program", fillcolor="#e2e8f0", color="#64748b", tooltip="line 1"];
    n1 [label="Let ok", fillcolor="#e0e7ff", color="#6366f1", tooltip="line 2"];
    n2 [label="Binary ||", fillcolor="#fef3c7", color="#d97706", tooltip="line 2"];
    n3 [label="Binary &&", fillcolor="#fef3c7", color="#d97706", tooltip="line 2"];
    n4 [label="Unary !", fillcolor="#fef3c7", color="#d97706", tooltip="line 2"];
    n5 [label="Bool false", fillcolor="#d1fae5", color="#059669", tooltip="line 2"];
    n4 -> n5;
    n3 -> n4;
    n6 [label="Binary <=", fillcolor="#fef3c7", color="#d97706", tooltip="line 2"];
    n7 [label="Binary +", fillcolor="#fef3c7", color="#d97706", tooltip="line 2"];
    n8 [label="Integer 1", fillcolor="#d1fae5", color="#059669", tooltip="line 2"];
    n7 -> n8;
    n9 [label="Integer 2", fillcolor="#d1fae5", color="#059669", tooltip="line 2"];
    n7 -> n9;
    n6 -> n7;
    n10 [label="Integer 3", fillcolor="#d1fae5", color="#059669", tooltip="line 2"];
    n6 -> n10;
    n3 -> n6;
    n2 -> n3;
    n11 [label="Binary !=", fillcolor="#fef3c7", color="#d97706", tooltip="line 2"];
    n12 [label="Integer 4", fillcolor="#d1fae5", color="#059669", tooltip="line 2"];
    n11 -> n12;
    n13 [label="Integer 5", fillcolor="#d1fae5", color="#059669", tooltip="line 2"];
    n11 -> n13;
    n2 -> n11;
    n1 -> n2;
    n0 -> n1;
    n14 [label="ExprStmt", fillcolor="#e0e7ff", color="#6366f1", tooltip="line 3"];
    n15 [label="Call print", fillcolor="#ffe4e6", color="#e11d48", tooltip="line 3"];
    n16 [label="Identifier ok", fillcolor="#e0f2fe", color="#0284c7", tooltip="line 3"];
    n15 -> n16;
    n14 -> n15;
    n0 -> n14;
}
