// ! flips a bool.
print(!true);
print(!false);
print(!!true);

// && needs both sides true; || needs either.
print(true && false);
print(true && true);
print(false || true);
print(false || false);

// && groups before ||, and both come after comparison and equality.
print(true || false && false);
print(1 < 2 && 2 < 3);
print(1 > 2 || 2 > 1);
print(!(1 < 2));
print(!true == false);

// The right-hand side is skipped when the left already settles the answer.
let zero = 0;
print(false && 1 / zero == 1);
print(true || 1 / zero == 1);

let between = 1 < 5 && 5 < 10;
print(between);
